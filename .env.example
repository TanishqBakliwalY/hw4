# Copy this file to .env (in the hw4/ folder) and fill in your own values.
# .env is git-ignored -- never commit real keys.

# Required: Portkey API key used to call OpenAI (gpt-5.6-luna) through the Portkey gateway.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional (defaults shown)
PORTKEY_BASE_URL=https://api.portkey.ai/v1
CHAT_MODEL=gpt-5.6-luna

# Optional: set to 1 when serving over HTTPS so the session cookie is Secure-only.
COOKIE_SECURE=0
